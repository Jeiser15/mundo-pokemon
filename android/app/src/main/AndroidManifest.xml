<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Los datos y las imágenes llegan de PokéAPI y de GitHub. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Mundo Pokémon"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Tema"
        android:supportsRtl="true">

        <!-- configChanges: al girar el celular no se recarga la página (no se pierde un combate a medias). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
